{
  "parser": "@babel/eslint-parser",
  "extends": [],
  "env": {
    "browser": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 8,
    "sourceType": "module",
    "requireConfigFile": false
  },
  "rules": {
    "semi": "off",
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-console": "off"
  }
}
